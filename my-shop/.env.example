# Copy this file to .env.local and fill in your own NocoDB values.
# .env.local is git-ignored so secrets never get committed.
REACT_APP_NC_BASE_URL=http://localhost:8090
REACT_APP_NC_TOKEN=your_nocodb_api_token_here
REACT_APP_NC_BASE_ID=your_base_id_here
REACT_APP_NC_TABLE_ID=your_products_table_id_here
REACT_APP_NC_CUSTOMERS_TABLE_ID=your_customers_table_id_here
REACT_APP_NC_ORDERS_TABLE_ID=your_orders_table_id_here
